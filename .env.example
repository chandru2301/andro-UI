# Andro UI environment
#
# Copy to `.env.local` (git-ignored) and fill in.

# Groq API key for plain-English narration of agent activity.
# Without it the UI still works: narration falls back to deterministic
# phrasing generated locally, so the transcript is never empty or blocked.
# Get a key at https://console.groq.com/keys
#
# NOTE: no VITE_ prefix on purpose. Vite inlines VITE_ vars into the renderer
# bundle; this one is read by the Electron main process and stays out of the UI.
GROQ_API_KEY=

# Groq model for narration (default: qwen/qwen3.8-27b).
# Groq retires models periodically, so this is overridable. Verify what exists:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# GROQ_MODEL=qwen/qwen3.8-27b

# Andro MCP activity stream. Defaults to the local server; override only if
# your browser-agent-mcp instance runs elsewhere.
VITE_ANDRO_EVENTS_URL=http://127.0.0.1:8787/activity/events-ui
